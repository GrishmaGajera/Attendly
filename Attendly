  <script>
    // ===== CONFIG: Default Apps Script URL =====
    // Replace this with your actual Apps Script Web App URL
    const DEFAULT_API_URL = 'https://script.google.com/macros/s/AKfycbzHpO1DVpQttLcrXhcJQykBfeKPa0eg9oYKXd2tJAG7oU4UEm-PPrHk1ToDCtd478avBw/exec';

    let appState = { apiUrl:'', semStartDate:'', timetable:{}, overrides:{} };
    let currentUser = { name:'', college:'', role:'Guest', status:'Unverified', remark:'' };
    let pendingAccessRequests = [];
    let activeMonthDate = new Date();
    let selectedDateStr = null;
    let monthModalTarget = new Date();
    let busy = false;

    // ===== NAME NORMALIZATION: Case-insensitive + Title Case display =====
    function toTitleCase(str) {
      return str.replace(/\w\S*/g, function(txt){
        return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase();
      });
    }
    function normalizeName(name) {
      return name.trim().replace(/\s+/g, ' '); // collapse multiple spaces
    }
    function getDisplayName(rawName) {
      return toTitleCase(normalizeName(rawName)); // "qwen smith" → "Qwen Smith"
    }

    // ===== PER-USER STORAGE (case-insensitive key) =====
    function userDataKey(){ 
      return 'attendly_data_' + (currentUser.name || 'guest').toLowerCase().replace(/\s+/g, '_'); 
    }

    function loadUserData(){
      appState.semStartDate=''; appState.timetable={}; appState.overrides={};
      if(!currentUser.name) return;
      const s = localStorage.getItem(userDataKey());
      if(s){ try{ const p=JSON.parse(s); appState.semStartDate=p.semStartDate||''; appState.timetable=p.timetable||{}; appState.overrides=p.overrides||{}; }catch(e){} }
      if(!appState.semStartDate){ appState.semStartDate=getTodayStr(); saveUserData(); }
      document.getElementById('input-sem-start').value = appState.semStartDate;
    }

    function saveUserData(){
      if(!currentUser.name) return;
      localStorage.setItem(userDataKey(), JSON.stringify({ semStartDate:appState.semStartDate, timetable:appState.timetable, overrides:appState.overrides }));
    }

    window.onload = function() {
      // Load URL: try localStorage first, then default (works on mobile too)
      appState.apiUrl = localStorage.getItem('attendly_api_url') || DEFAULT_API_URL;
      document.getElementById('input-api-url').value = appState.apiUrl;

      const savedName = localStorage.getItem('attendly_user_name');
      if (savedName) {
        currentUser.name = getDisplayName(savedName); // normalize on load
        loadUserData();
        setPhase('loading');
        bootstrap(false);
      } else {
        document.getElementById('input-sem-start').value = getTodayStr();
        setPhase('guest');
        renderApp();
      }
      setInterval(() => { if (currentUser.name && !busy) bootstrap(false, true); }, 25000);
    };

    async function apiRequest(action, payload={}) {
      if (!appState.apiUrl || appState.apiUrl === 'PASTE_YOUR_APPS_SCRIPT_URL_HERE') return null;
      try {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 25000);
        const res = await fetch(appState.apiUrl, {
          method:'POST', headers:{'Content-Type':'text/plain'},
          body: JSON.stringify({action, name: currentUser.name, college: currentUser.college || '', ...payload}), // send Title Case name
          signal: ctrl.signal
        });
        clearTimeout(timer);
        return await res.json();
      } catch(e) { return null; }
    }

    async function bootstrap(requestAccess, silent) {
      if (busy) return;
      busy = true;
      if (!silent) setPhase('loading');

      const res = await apiRequest('bootstrap', { request: !!requestAccess });
      busy = false;

      if (!res || !res.success) {
        if (!silent) {
          setPhase('error');
          if (!appState.apiUrl || appState.apiUrl === 'PASTE_YOUR_APPS_SCRIPT_URL_HERE') {
            document.getElementById('error-detail').innerText = 'Database not configured. Contact admin.';
          } else {
            document.getElementById('error-detail').innerText = 'Admin: check the Apps Script URL in ⚙️ Settings.';
          }
        }
        return;
      }

      currentUser.role = res.role || 'User';
      currentUser.status = res.status;
      currentUser.remark = res.remark || '';

      if (res.requests) {
        pendingAccessRequests = res.requests;
        document.getElementById('pending-count').innerText = res.requests.length;
        renderPendingRequestsList();
      }
      if (res.notifications && res.notifications.length) showToast(res.notifications);

      if (res.status === 'Pending' || res.status === 'Approved') {
        localStorage.setItem('attendly_user_name', currentUser.name);
      }

      updateAuthUI();
      renderApp();
    }

    function retryAuth() { if (currentUser.name) bootstrap(false); else setPhase('guest'); }

    function checkStatusNow() {
      if (!appState.apiUrl || appState.apiUrl === 'PASTE_YOUR_APPS_SCRIPT_URL_HERE') {
        alert('Database not configured. Please contact your admin.');
        return;
      }
      bootstrap(false);
    }

    async function handleAuthAction() {
      const nameInput = document.getElementById('user-name-input');
      const collegeInput = document.getElementById('user-college-input');
      const rawName = nameInput.value.trim();
      const rawCollege = collegeInput.value.trim();

      // Validate name
      if (!rawName) {
        document.getElementById('guest-error').classList.remove('hidden');
        document.getElementById('guest-error-college').classList.add('hidden');
        nameInput.classList.add('shake', 'border-rose-400');
        setTimeout(() => nameInput.classList.remove('shake'), 500);
        nameInput.focus();
        return;
      }
      nameInput.classList.remove('border-rose-400');
      document.getElementById('guest-error').classList.add('hidden');

      // Validate college
      if (!rawCollege) {
        document.getElementById('guest-error-college').classList.remove('hidden');
        collegeInput.classList.add('shake', 'border-rose-400');
        setTimeout(() => collegeInput.classList.remove('shake'), 500);
        collegeInput.focus();
        return;
      }
      collegeInput.classList.remove('border-rose-400');
      document.getElementById('guest-error-college').classList.add('hidden');

      // Convert to Title Case
      const displayName = getDisplayName(rawName);
      const displayCollege = getDisplayName(rawCollege);
      currentUser.name = displayName;
      currentUser.college = displayCollege;
      loadUserData();
      await bootstrap(true);
    }

    function logoutUser() {
      saveUserData();
      localStorage.removeItem('attendly_user_name');
      currentUser = { name:'', college:'', role:'Guest', status:'Unverified', remark:'' };
      appState.semStartDate=''; appState.timetable={}; appState.overrides={};
      pendingAccessRequests = [];
      const input = document.getElementById('user-name-input');
      document.getElementById('user-college-input').value = '';
      document.getElementById('guest-error').classList.add('hidden');
      input.classList.remove('border-rose-400');
      updateAuthUI();
      setPhase('guest');
      renderApp();
      input.focus();
    }

    function setPhase(phase) {
      ['guest','loading','pending','rejected','approved','error'].forEach(p => {
        document.getElementById('phase-' + p).classList.add('hidden');
      });
      document.getElementById('phase-' + phase).classList.remove('hidden');
    }

    function updateAuthUI() {
      const tracker = document.getElementById('tracker-section');
      const analyticsCol = document.getElementById('analytics-col');
      const analyticsBottom = document.getElementById('analytics-bottom');
      const calendarCol = document.getElementById('calendar-col');
      const adminBadge = document.getElementById('admin-badge');

      if (currentUser.status === 'Pending') {
        setPhase('pending');
        document.getElementById('pending-name-1').innerText = currentUser.name; // Title Case
        tracker.classList.add('hidden');
        adminBadge.classList.add('hidden');
      } else if (currentUser.status === 'Rejected') {
        setPhase('rejected');
        document.getElementById('rejection-remark').innerText = '"' + (currentUser.remark || 'No reason given') + '"';
        tracker.classList.add('hidden');
        adminBadge.classList.add('hidden');
      } else if (currentUser.role === 'Admin') {
        setPhase('approved');
        document.getElementById('welcome-name').innerText = currentUser.name; // Title Case
        document.getElementById('welcome-sub').innerText = '🛡️ Administrator • Full access';
        tracker.classList.remove('hidden');
        analyticsCol.classList.remove('hidden');
        analyticsBottom.classList.remove('hidden');
        calendarCol.classList.remove('lg:col-span-12'); calendarCol.classList.add('lg:col-span-5');
        adminBadge.classList.remove('hidden');
      } else if (currentUser.status === 'Approved') {
        setPhase('approved');
        document.getElementById('welcome-name').innerText = currentUser.name;
        document.getElementById('welcome-sub').innerText = '✅ ' + (currentUser.college || 'Access granted') + ' • Tap a day to mark attendance';
        tracker.classList.remove('hidden');
        analyticsCol.classList.remove('hidden');
        analyticsBottom.classList.remove('hidden');
        calendarCol.classList.remove('lg:col-span-12'); calendarCol.classList.add('lg:col-span-5');
        adminBadge.classList.add('hidden');
      } else {
        setPhase('guest');
        tracker.classList.add('hidden');
        adminBadge.classList.add('hidden');
      }

      // URL field: ONLY visible to Admin (hidden during setup & for normal users)
      const urlSection = document.getElementById('api-url-section');
      if (currentUser.role === 'Admin') {
        urlSection.classList.remove('hidden');
      } else {
        urlSection.classList.add('hidden');
      }
    }

    function showToast(messages) {
      const box = document.getElementById('toast-box');
      box.innerHTML = '';
      messages.forEach(m => {
        const d = document.createElement('div');
        d.className = 'bg-slate-900 text-white text-xs font-bold px-4 py-3 rounded-xl shadow-lg';
        d.innerText = m;
        box.appendChild(d);
      });
      box.classList.remove('hidden');
      setTimeout(() => { box.classList.add('hidden'); }, 6000);
    }

    function renderPendingRequestsList() {
      const list = document.getElementById('access-requests-list');
      list.innerHTML = '';
      if (!pendingAccessRequests.length) { list.innerHTML = `<p class="text-xs text-center text-slate-400 py-4">No pending requests 🎈</p>`; return; }
      pendingAccessRequests.forEach(req => {
        const safe = req.name.replace(/[^a-zA-Z0-9]/g,'-');
        const item = document.createElement('div');
        item.className = 'bg-slate-50 p-4 rounded-xl border border-slate-100 space-y-3';
        item.innerHTML = `
          <div class="flex justify-between items-center"><span class="font-bold text-sm">${req.name}</span><span class="text-[10px] text-slate-400">${req.date || ''}</span></div>
          <p class="text-[11px] text-slate-500 font-medium">🏫 ${req.college || 'N/A'}</p>
          <div class="flex gap-2">
            <button onclick="approveUser('${req.name.replace(/'/g,"\\'")}')" class="flex-1 bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-1.5 rounded-lg text-xs">✅ Grant</button>
            <button onclick="document.getElementById('rb-${safe}').classList.toggle('hidden')" class="flex-1 bg-rose-500 hover:bg-rose-600 text-white font-bold py-1.5 rounded-lg text-xs">❌ Reject</button>
          </div>
          <div id="rb-${safe}" class="hidden flex gap-2">
            <input type="text" id="rm-${safe}" placeholder="Remark (e.g., invalid name)" class="flex-1 text-xs border rounded-lg p-1.5"/>
            <button onclick="rejectUser('${req.name.replace(/'/g,"\\'")}')" class="bg-rose-700 text-white font-bold px-3 rounded-lg text-xs">OK</button>
          </div>`;
        list.appendChild(item);
      });
    }

    async function approveUser(n) { const r = await apiRequest('approveAccess', { targetName: n }); if (r && r.success) bootstrap(false, true); }
    async function rejectUser(n) {
      const safe = n.replace(/[^a-zA-Z0-9]/g,'-');
      const rm = document.getElementById('rm-' + safe).value.trim();
      if (!rm) { alert('Please write a remark for the rejection.'); return; }
      const r = await apiRequest('rejectAccess', { targetName: n, remark: rm });
      if (r && r.success) bootstrap(false, true);
    }

    function saveAndSyncState() { saveUserData(); renderApp(); }

    function resetAllData() {
      if (confirm('Reset all your data on this device? Your timetable and attendance logs will be erased.')) {
        appState.timetable = {};
        appState.overrides = {};
        appState.semStartDate = getTodayStr();
        saveUserData();
        document.getElementById('input-sem-start').value = appState.semStartDate;
        renderApp(); closeModal('settings-modal');
      }
    }

    function formatDateStr(d){ return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }
    function getTodayStr(){ return formatDateStr(new Date()); }
    function pct(a,c){ return c>0 ? ((a/c)*100).toFixed(1)+'%' : '—'; }
    function colorCls(a,c){ if(!c) return 'text-slate-400'; const p=a/c*100; return p<75?'text-rose-500':p<85?'text-orange-500':'text-emerald-600'; }

    function getOrInitOverride(ds){
      const dw = new Date(ds).getDay();
      const sch = appState.timetable[dw] || [];
      if (!appState.overrides[ds]) appState.overrides[ds] = { isHoliday:false, isFullAbsent:false, statuses:sch.map(s=>({...s,status:'Present'})) };
      return appState.overrides[ds];
    }

    function effectiveStatuses(ov, schedule) {
      const result = [];
      schedule.forEach(sch => {
        const found = (ov.statuses || []).find(st => st.subject === sch.subject && st.type === sch.type);
        result.push(found ? { ...found } : { ...sch, status: 'Present' });
      });
      return result;
    }

    function renderApp(){
      const isApproved = currentUser.status === 'Approved';
      if (isApproved) { renderCalendar(); renderMonthlyOverview(); renderSemesterOverview(); renderTrendAndProgress(); }
      renderTimetableList();
    }

    function renderCalendar(){
      const grid = document.getElementById('calendar-grid'); grid.innerHTML = '';
      const y = activeMonthDate.getFullYear(), m = activeMonthDate.getMonth(), today = getTodayStr();
      document.getElementById('calendar-title').innerText = activeMonthDate.toLocaleString('default',{month:'long',year:'numeric'});
      const fd = new Date(y,m,1).getDay(), td = new Date(y,m+1,0).getDate();
      for (let i=0;i<fd;i++){ const c=document.createElement('div'); c.className='aspect-square rounded-xl bg-slate-50/50 opacity-30'; grid.appendChild(c); }
      for (let d=1;d<=td;d++){
        const cur=new Date(y,m,d), ds=formatDateStr(cur), sch=appState.timetable[cur.getDay()]||[];
        const cell=document.createElement('button');
        cell.className='aspect-square rounded-xl flex items-center justify-center font-bold text-sm transition-all shadow-sm ';
        if (ds < appState.semStartDate || ds > today) { cell.className += 'day-future cursor-default'; cell.innerText = d; }
        else {
          const ov = getOrInitOverride(ds);
          const eff = effectiveStatuses(ov, sch);
          let cc='day-present';
          if (ov.isHoliday) cc='day-holiday';
          else if (ov.isFullAbsent) cc='day-absent';
          else if (eff.length) {
            const ac = eff.filter(s=>s.status==='Absent').length;
            if (ac===eff.length) cc='day-absent';
            else if (ac>0) cc='day-partial';
          } else cc='day-future';
          cell.className += cc + ' hover:scale-105 cursor-pointer'; cell.innerText = d;
          cell.onclick = () => openDayModal(ds);
        }
        grid.appendChild(cell);
      }
    }
    function changeMonth(d){ activeMonthDate.setMonth(activeMonthDate.getMonth()+d); renderApp(); }
    function goToToday(){ activeMonthDate = new Date(); renderApp(); }

    function calculateStats(start,end){
      const stats={}, today=getTodayStr();
      Object.values(appState.timetable).flat().forEach(s=>{ if(!stats[s.subject]) stats[s.subject]={lec:{c:0,a:0},lab:{c:0,a:0},tut:{c:0,a:0}}; });
      let cur=new Date(start); const ed=new Date(end);
      while(cur<=ed){
        const ds=formatDateStr(cur);
        if (ds>=appState.semStartDate && ds<=today){
          const sch = appState.timetable[cur.getDay()] || [];
          if (sch.length){
            const ov = getOrInitOverride(ds);
            if (!ov.isHoliday){
              effectiveStatuses(ov, sch).forEach(s=>{
                if(!stats[s.subject]) stats[s.subject]={lec:{c:0,a:0},lab:{c:0,a:0},tut:{c:0,a:0}};
                let cat = s.type==='Lab'?'lab':s.type==='Tutorial'?'tut':'lec';
                stats[s.subject][cat].c++;
                if(!ov.isFullAbsent && s.status==='Present') stats[s.subject][cat].a++;
              });
            }
          }
        }
        cur.setDate(cur.getDate()+1);
      }
      return stats;
    }

    function renderMonthlyOverview(){
      const y=activeMonthDate.getFullYear(), m=activeMonthDate.getMonth();
      document.getElementById('monthly-sub-title').innerText = `(${activeMonthDate.toLocaleString('default',{month:'long',year:'numeric'})})`;
      renderTable('monthly-tbody', calculateStats(formatDateStr(new Date(y,m,1)), formatDateStr(new Date(y,m+1,0))));
    }
    function renderSemesterOverview(){
      document.getElementById('semester-sub-title').innerText = `(From ${appState.semStartDate})`;
      renderTable('semester-tbody', calculateStats(appState.semStartDate, getTodayStr()));
    }
    function renderTable(id,stats){
      const tbody=document.getElementById(id); tbody.innerHTML='';
      const subs=Object.keys(stats).filter(s=>{const it=stats[s];return (it.lec.c+it.lab.c+it.tut.c)>0;});
      if(!subs.length){ tbody.innerHTML=`<tr><td colspan="6" class="text-center py-4 text-slate-400 text-xs">No data yet. Add subjects in ⚙️ Settings to begin 📚</td></tr>`; return; }
      subs.forEach(sub=>{
        const it=stats[sub], tc=it.lec.c+it.lab.c+it.tut.c, ta=it.lec.a+it.lab.a+it.tut.a;
        const tr=document.createElement('tr');
        tr.className='hover:bg-slate-50/80 cursor-pointer transition-colors';
        tr.onclick=()=>openSubjectModal(sub,it);
        tr.innerHTML=`
          <td class="py-3 font-bold text-[#00bfff]">${sub}</td>
          <td class="py-3 text-center text-slate-600 font-medium">${it.lec.c>0?`${it.lec.a}/${it.lec.c}`:'-'}</td>
          <td class="py-3 text-center text-slate-600 font-medium">${it.lab.c>0?`${it.lab.a}/${it.lab.c}`:'-'}</td>
          <td class="py-3 text-center text-slate-600 font-medium">${it.tut.c>0?`${it.tut.a}/${it.tut.c}`:'-'}</td>
          <td class="py-3 text-center font-bold text-slate-900">${ta}/${tc}</td>
          <td class="py-3 text-right font-extrabold ${colorCls(ta,tc)}">${pct(ta,tc)}</td>`;
        tbody.appendChild(tr);
      });
    }

    function renderTrendAndProgress(){
      const chart=document.getElementById('trend-bar-chart'); chart.innerHTML='';
      const ss=new Date(appState.semStartDate), today=new Date();
      let sm=new Date(ss.getFullYear(),ss.getMonth(),1);
      const em=new Date(today.getFullYear(),today.getMonth(),1);
      let gc=0, ga=0;
      while(sm<=em){
        const stats=calculateStats(formatDateStr(sm), formatDateStr(new Date(sm.getFullYear(),sm.getMonth()+1,0)));
        let mc=0,ma=0;
        Object.values(stats).forEach(s=>{mc+=s.lec.c+s.lab.c+s.tut.c; ma+=s.lec.a+s.lab.a+s.tut.a;});
        gc+=mc; ga+=ma;
        const p=mc>0?Math.round((ma/mc)*100):0;
        const lbl=sm.toLocaleString('default',{month:'short',year:'2-digit'});
        const target=new Date(sm);
        const bar=document.createElement('div');
        bar.className='flex flex-col items-center flex-1 cursor-pointer group';
        bar.onclick=()=>openMonthModal(target);
        bar.innerHTML=`
          <span class="text-[10px] font-extrabold text-slate-700 mb-1 opacity-90">${p}%</span>
          <div class="w-7 sm:w-10 bg-slate-100 rounded-t-lg h-32 flex items-end overflow-hidden">
            <div class="w-full bg-[#00bfff] rounded-t-lg transition-all duration-300 group-hover:bg-blue-600" style="height:${Math.max(p,4)}%"></div>
          </div>
          <span class="text-[10px] font-bold text-slate-400 mt-2">${lbl}</span>`;
        chart.appendChild(bar);
        sm.setMonth(sm.getMonth()+1);
      }
      const op=gc>0?((ga/gc)*100).toFixed(2):'0.00';
      document.getElementById('stat-conducted').innerText=gc;
      document.getElementById('stat-attended').innerText=ga;
      document.getElementById('stat-pct').innerText=op+'%';
      document.getElementById('overall-pct-text').innerText=op+'%';
      document.getElementById('donut-fill').setAttribute('stroke-dasharray', `${op},100`);
    }

    function openMonthModal(monthDate){
      monthModalTarget = new Date(monthDate);
      const y=monthDate.getFullYear(), m=monthDate.getMonth();
      const title=monthDate.toLocaleString('default',{month:'long',year:'numeric'});
      document.getElementById('month-modal-title').innerText = title;
      const stats=calculateStats(formatDateStr(new Date(y,m,1)), formatDateStr(new Date(y,m+1,0)));
      let tc=0, ta=0;
      const tt={lec:{c:0,a:0},lab:{c:0,a:0},tut:{c:0,a:0}};
      Object.values(stats).forEach(s=>{ ['lec','lab','tut'].forEach(k=>{ tt[k].c+=s[k].c; tt[k].a+=s[k].a; tc+=s[k].c; ta+=s[k].a; }); });
      let html = `
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 text-center">
          <div class="text-3xl font-black text-slate-900">${ta} <span class="text-slate-400 text-xl">/ ${tc}</span></div>
          <div class="text-xs font-bold text-slate-500 mt-0.5">total classes attended in ${title}</div>
          <div class="text-base font-black ${colorCls(ta,tc)} mt-1">${pct(ta,tc)}</div>
        </div>
        <div class="grid grid-cols-3 gap-2 text-center">
          ${typeCard('📖 Lectures', tt.lec)}
          ${typeCard('🔬 Labs', tt.lab)}
          ${typeCard('📝 Tutorials', tt.tut)}
        </div>`;
      const subs=Object.keys(stats).filter(s=>{const it=stats[s];return (it.lec.c+it.lab.c+it.tut.c)>0;});
      if (subs.length){
        html += `<div class="space-y-2">`;
        subs.forEach(sub=>{
          const s=stats[sub];
          html += `
            <div class="bg-slate-50 border border-slate-100 rounded-xl p-3">
              <div class="font-bold text-xs text-[#00bfff] mb-1.5">${sub}</div>
              <div class="grid grid-cols-3 gap-1 text-[10px] font-semibold text-slate-600 text-center">
                <div>Lec ${s.lec.a}/${s.lec.c}<br/><span class="font-black ${colorCls(s.lec.a,s.lec.c)}">${pct(s.lec.a,s.lec.c)}</span></div>
                <div>Lab ${s.lab.a}/${s.lab.c}<br/><span class="font-black ${colorCls(s.lab.a,s.lab.c)}">${pct(s.lab.a,s.lab.c)}</span></div>
                <div>Tut ${s.tut.a}/${s.tut.c}<br/><span class="font-black ${colorCls(s.tut.a,s.tut.c)}">${pct(s.tut.a,s.tut.c)}</span></div>
              </div>
            </div>`;
        });
        html += `</div>`;
      } else {
        html += `<p class="text-xs text-center text-slate-400 py-2">No classes conducted this month.</p>`;
      }
      document.getElementById('month-modal-content').innerHTML = html;
      openModal('month-modal');
    }

    function typeCard(label, t){
      return `<div class="bg-slate-50 border border-slate-100 rounded-xl p-2">
        <div class="text-[10px] font-bold text-slate-400">${label}</div>
        <div class="text-sm font-black text-slate-800">${t.a}/${t.c}</div>
        <div class="text-[10px] font-black ${colorCls(t.a,t.c)}">${pct(t.a,t.c)}</div>
      </div>`;
    }

    function jumpToMonthFromModal(){ activeMonthDate = new Date(monthModalTarget); closeModal('month-modal'); renderApp(); }

    function openDayModal(ds){
      selectedDateStr=ds;
      const ov=getOrInitOverride(ds);
      const sch = appState.timetable[new Date(ds).getDay()] || [];
      ov.statuses = effectiveStatuses(ov, sch);
      document.getElementById('modal-date-title').innerText=ds;
      document.getElementById('modal-day-name').innerText=new Date(ds).toLocaleDateString('en-US',{weekday:'long'});
      document.getElementById('toggle-holiday').checked=ov.isHoliday;
      document.getElementById('toggle-full-absent').checked=ov.isFullAbsent;
      renderDayModalSchedule();
      openModal('day-modal');
    }
    function renderDayModalSchedule(){
      const list=document.getElementById('modal-schedule-list'); list.innerHTML='';
      const ov=appState.overrides[selectedDateStr];
      if (ov.isHoliday || ov.isFullAbsent){ list.innerHTML=`<p class="text-xs text-center text-slate-400 py-6 font-semibold">Day override active (Holiday / Full Absent).</p>`; return; }
      if (!ov.statuses.length){ list.innerHTML=`<p class="text-xs text-center text-slate-400 py-6 font-semibold">No classes scheduled on this day.</p>`; return; }
      ov.statuses.forEach((s,i)=>{
        const it=document.createElement('div');
        it.className='flex items-center justify-between bg-slate-50 p-3 rounded-xl border border-slate-100';
        it.innerHTML=`
          <div><span class="font-extrabold text-xs text-slate-900">${s.subject}</span><span class="text-[10px] font-semibold text-slate-400 block">${s.type}</span></div>
          <select onchange="updateClassStatus(${i},this.value)" class="text-xs font-bold border rounded-lg p-1.5 bg-white text-slate-800">
            <option value="Present"${s.status==='Present'?' selected':''}>Present</option>
            <option value="Absent"${s.status==='Absent'?' selected':''}>Absent</option>
          </select>`;
        list.appendChild(it);
      });
    }
    function updateClassStatus(i,v){ appState.overrides[selectedDateStr].statuses[i].status=v; saveUserData(); renderApp(); }
    function toggleHoliday(c){ appState.overrides[selectedDateStr].isHoliday=c; if(c) appState.overrides[selectedDateStr].isFullAbsent=false; saveUserData(); renderDayModalSchedule(); renderApp(); }
    function toggleFullAbsent(c){ appState.overrides[selectedDateStr].isFullAbsent=c; if(c) appState.overrides[selectedDateStr].isHoliday=false; saveUserData(); renderDayModalSchedule(); renderApp(); }

    function openSubjectModal(name,item){
      document.getElementById('subject-modal-title').innerText = name;
      const tc=item.lec.c+item.lab.c+item.tut.c, ta=item.lec.a+item.lab.a+item.tut.a;
      document.getElementById('subject-modal-content').innerHTML = `
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-3 text-center">
          <span class="text-2xl font-black text-slate-900">${ta} <span class="text-slate-400 text-base">/ ${tc}</span></span>
          <span class="text-sm font-black ${colorCls(ta,tc)} ml-2">${pct(ta,tc)}</span>
          <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Overall</div>
        </div>
        ${subjectTypeRow('📖 Lectures', item.lec)}
        ${subjectTypeRow('🔬 Labs', item.lab)}
        ${subjectTypeRow('📝 Tutorials', item.tut)}`;
      openModal('subject-modal');
    }
    function subjectTypeRow(label, t){
      return `<div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
        <div class="flex justify-between items-center">
          <span class="font-bold text-xs text-slate-700">${label}</span>
          <span class="text-xs font-bold text-slate-600">${t.a} / ${t.c}</span>
        </div>
        <div class="flex justify-between items-center mt-1">
          <div class="flex-1 bg-slate-200 rounded-full h-1.5 mr-3">
            <div class="bg-[#00bfff] h-1.5 rounded-full" style="width:${t.c>0?(t.a/t.c*100):0}%"></div>
          </div>
          <span class="text-xs font-black ${colorCls(t.a,t.c)}">${pct(t.a,t.c)}</span>
        </div>
      </div>`;
    }

    function addScheduleEntry(){
      const day=parseInt(document.getElementById('input-day-select').value);
      const subInput=document.getElementById('input-sub-name');
      const sub=subInput.value.trim();
      const type=document.getElementById('input-type-select').value;
      const err=document.getElementById('sub-error');
      if(!sub){
        err.classList.remove('hidden');
        subInput.classList.add('shake','border-rose-400');
        setTimeout(()=>subInput.classList.remove('shake'),500);
        subInput.focus();
        return;
      }
      err.classList.add('hidden');
      subInput.classList.remove('border-rose-400');
      if(!appState.timetable[day]) appState.timetable[day]=[];
      appState.timetable[day].push({subject:sub,type});
      subInput.value='';
      saveUserData(); renderTimetableList(); renderApp();
      subInput.focus();
    }
    function removeScheduleEntry(day,idx){
      appState.timetable[day].splice(idx,1);
      if(!appState.timetable[day].length) delete appState.timetable[day];
      saveUserData(); renderTimetableList(); renderApp();
    }
    function renderTimetableList(){
      const c=document.getElementById('timetable-list'); c.innerHTML='';
      const dn=['Sun','Mon','Tue','Wed','Thu','Fri','Sat']; let has=false;
      Object.keys(appState.timetable).forEach(d=>{
        appState.timetable[d].forEach((item,i)=>{
          has=true;
          const r=document.createElement('div');
          r.className='flex justify-between items-center bg-white p-2 rounded border';
          r.innerHTML=`<span><b>${dn[d]}:</b> ${item.subject} (${item.type})</span><button onclick="removeScheduleEntry(${d},${i})" class="text-rose-500 font-bold px-1 hover:text-rose-700">✕</button>`;
          c.appendChild(r);
        });
      });
      if(!has) c.innerHTML=`<p class="text-slate-400 text-center py-2">No subjects yet. Add your first class above 📚</p>`;
    }

    function saveSettings(){
      const sv=document.getElementById('input-sem-start').value;
      const av=document.getElementById('input-api-url').value.trim();
      if(sv) appState.semStartDate=sv;
      if (currentUser.role==='Admin'){
        appState.apiUrl=av;
        localStorage.setItem('attendly_api_url', av); // save for all users on this device
      }
      saveUserData(); renderApp(); closeModal('settings-modal');
      if (currentUser.name) bootstrap(false,true);
    }

    function openModal(id){ document.getElementById(id).classList.remove('hidden'); document.getElementById(id).classList.add('flex'); }
    function closeModal(id){ document.getElementById(id).classList.add('hidden'); document.getElementById(id).classList.remove('flex'); }
  </script>
</body>
</html>
