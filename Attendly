.ek-word{
  font-family: 'Times New Roman', Times, serif;
  font-weight:800;
  letter-spacing:.32em;
  font-size:15px;
  background:linear-gradient(180deg,#d9b968,#8a6a26);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  white-space:nowrap;
}
.ek-brand{ display:flex; flex-direction:column; align-items:center; gap:2px; }

.a-logo{ --sz:48px; position:relative; width:var(--sz); height:var(--sz); }
.a-logo i,.a-logo::before,.a-logo::after{ position:absolute; }
.a-logo::before{ content:""; inset:10% 11% 12%; border-radius:28%; background:linear-gradient(180deg,rgba(99,189,242,.38),rgba(99,189,242,.20)); }
.a-logo .g{ inset:0; background:linear-gradient(180deg,rgba(126,186,238,.50),rgba(126,186,238,.30)); clip-path:polygon(44% 6%,47% 4%,53% 4%,56% 6%,86% 94%,70% 97%,50% 62%,30% 97%,14% 94%); }
.a-logo .g::before{ content:""; position:absolute; left:21%; top:22%; width:58%; height:64%; clip-path:polygon(2% 100%,39% 7%,43% 2%,48% 0,56% 0,61% 2%,65% 7%,98% 100%,72% 100%,50% 33%,28% 100%); background:radial-gradient(60% 45% at 50% 0%,rgba(255,255,255,.30),transparent 60%),linear-gradient(100deg,transparent 0 54%,rgba(8,80,150,.38) 54%),linear-gradient(180deg,#58bcf6,#2196e8 55%,#0f85dc); filter:drop-shadow(0 1px 2px rgba(20,110,180,.35)); }
.a-logo::after{ content:""; left:43.5%; top:61%; width:13%; height:6%; border-radius:999px; background:#4fb2ef; }
body { font-family:'Inter',sans-serif; background-color:#f8fafc; }
.day-present { background-color:#00bfff; color:#fff; }
.day-absent { background-color:#ff0066; color:#fff; }
.day-partial { background:linear-gradient(180deg,#00bfff 50%,#ff0066 50%); color:#fff; }
.day-holiday { background-color:#f1f5f9; border:2px dashed #94a3b8!important; color:#64748b; }
.day-future { background-color:#fff; border:1px solid #f1f5f9; color:#cbd5e1; }
.donut-chart { transform:rotate(-90deg); }
::-webkit-scrollbar { width:6px; height:6px; }
::-webkit-scrollbar-thumb { background:#cbd5e1; border-radius:4px; }
.loading-spinner { border:3px solid #e2e8f0; border-top:3px solid #00bfff; border-radius:50%; width:18px; height:18px; animation:spin .7s linear infinite; display:inline-block; vertical-align:middle; }
@keyframes spin { 0%{transform:rotate(0)} 100%{transform:rotate(360deg)} }
.shake { animation: shake .4s; }
@keyframes shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-6px)} 75%{transform:translateX(6px)} }
